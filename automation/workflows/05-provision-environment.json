    {"parameters":{"httpMethod":"POST","path":"provision-onboarding","responseMode":"responseNode","options":{}},"id":"bf53349a-eec5-4afb-a70e-6383193ec670","name":"Provisioning Request","type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[100,300],"webhookId":"105af151-9135-4e4a-b192-5585490c75f6"},
    {"parameters":{"jsCode":"const body=$json.body??$json;const id=String(body.onboarding_id??'');if(!/^[0-9a-f-]{36}$/i.test(id))throw new Error('Valid onboarding_id is required');return[{json:{onboarding_id:id}}];"},"id":"3180e2c4-a1f8-49da-b1dd-61ac7d91d488","name":"Validate Provisioning","type":"n8n-nodes-base.code","typeVersion":2,"position":[320,300]},
    {"parameters":{"operation":"executeQuery","query":"DO $$ BEGIN IF NOT EXISTS(SELECT 1 FROM app.onboardings WHERE id=$1::uuid AND status IN ('READY_TO_PROVISION','PROVISIONING')) THEN RAISE EXCEPTION 'Onboarding is not ready to provision'; END IF; IF EXISTS(SELECT 1 FROM app.provisioning_steps WHERE onboarding_id=$1::uuid AND status='SUCCEEDED') THEN RAISE EXCEPTION 'Onboarding already has provisioned resources'; END IF; UPDATE app.onboardings SET status='PROVISIONING',progress_percent=40,blocking_reason=NULL,updated_at=now() WHERE id=$1::uuid; INSERT INTO app.provisioning_steps(id,onboarding_id,provider,operation,status) VALUES(gen_random_uuid(),$1::uuid,'clickup','create_project','IN_PROGRESS'),(gen_random_uuid(),$1::uuid,'google_drive','create_folder_tree','IN_PROGRESS'),(gen_random_uuid(),$1::uuid,'slack','create_channel','IN_PROGRESS') ON CONFLICT(onboarding_id,provider,operation) DO UPDATE SET status='IN_PROGRESS',last_error=NULL,updated_at=now(); END $$; SELECT o.id AS onboarding_id,c.display_name AS client_name,c.primary_contact_name,c.primary_contact_email,d.name AS deal_name,st.initial_tasks,st.drive_folders,cu.configuration->>'space_id' AS clickup_space_id FROM app.onboardings o JOIN app.clients c ON c.id=o.client_id JOIN app.deals d ON d.id=o.deal_id JOIN app.service_templates st ON st.key=d.service_template_key JOIN app.integration_connections cu ON cu.provider='clickup' AND cu.health='healthy' JOIN app.integration_connections gd ON gd.provider='google_drive' AND gd.health='healthy' JOIN app.integration_connections sl ON sl.provider='slack' AND sl.health='healthy' WHERE o.id=$1::uuid;","options":{"queryReplacement":"={{$json.onboarding_id}}"}},"id":"dd27d783-73ed-4d53-ae46-a035cfba30d7","name":"Begin Real Provisioning","type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[550,300],"credentials":{"postgres":{"id":"pWvncY5EEynulaOP","name":"Postgres account"}}},
    {"parameters":{"jsCode":"const slug=String($json.client_name).toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'').slice(0,55);return[{json:{...$json,resource_name:`${$json.client_name} — Client Onboarding`,channel_name:`client-${slug}-${String($json.onboarding_id).slice(0,6)}`.slice(0,80)}}];"},"id":"48b6b875-8e8d-4b38-82f6-8ecb6d7b2ad4","name":"Build Resource Names","type":"n8n-nodes-base.code","typeVersion":2,"position":[780,300]},
