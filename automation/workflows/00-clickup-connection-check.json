      "parameters":{"authentication":"predefinedCredentialType","nodeCredentialType":"clickUpApi","url":"={{ 'https://api.clickup.com/api/v2/team/' + $json.workspace_id + '/space?archived=false' }}","options":{}},
      "id":"163878d9-f887-4873-b1f5-4208c78e0973",
      "name":"Get Workspace Spaces",
      "type":"n8n-nodes-base.httpRequest",
      "typeVersion":4.4,
