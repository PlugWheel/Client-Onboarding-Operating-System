    },
    {
      "parameters":{"operation":"executeQuery","query":"UPDATE app.integration_connections SET mode='sandbox',health='healthy',credential_name='ClickUp account',configuration=configuration || convert_from(decode($1,'base64'),'UTF8')::jsonb,last_checked_at=now(),last_error=NULL,updated_at=now() WHERE provider='clickup' RETURNING display_name,mode,health,last_checked_at,configuration;","options":{"queryReplacement":"={{ $json.config_base64 }}"}},
      "id":"6ba1d6a0-e050-443f-a172-67eb2b49e138",
