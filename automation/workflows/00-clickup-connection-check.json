      "credentials":{"clickUpApi":{"id":"izDvzpvHo6wwzi5R","name":"ClickUp account"}}
    },
    {
      "parameters":{"jsCode":"const workspace=$('Select Workspace').item.json; const spaces=$json.spaces??[]; if(!spaces.length) throw new Error('ClickUp Workspace has no accessible Space'); const space=spaces.find(s=>!s.private)??spaces[0]; const config={...workspace,space_id:String(space.id),space_name:String(space.name??''),space_count:spaces.length}; return [{json:{...config,config_base64:Buffer.from(JSON.stringify(config)).toString('base64')}}];"},
      "id":"088ceef7-ea5f-4475-9c0f-d69ec0b52f80",
