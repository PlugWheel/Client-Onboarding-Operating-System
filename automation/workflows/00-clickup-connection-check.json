    {
      "parameters":{"jsCode":"const teams=$json.teams??[]; if(!teams.length) throw new Error('ClickUp credential is valid but no authorized Workspace was returned'); const team=teams[0]; return [{json:{workspace_id:String(team.id),workspace_name:String(team.name??''),workspace_count:teams.length}}];"},
