      "parameters":{"jsCode":"const source=$('Load Open Envelopes').item.json; const status=String($json.status??'').toLowerCase(); const terminal=['completed','declined','voided'].includes(status); const normalized={provider:'docusign',event_id:`docusign:${source.envelope_id}:${status}`,event_type:`envelope.${status}`,onboarding_id:String(source.onboarding_id),source_deal_id:String(source.source_deal_id),requirement_key:'contract',result:status==='completed'?'signed':status==='declined'||status==='voided'?'rejected':'pending',external_object_id:String(source.envelope_id)}; return [{json:{...source,status,terminal,completed_at:$json.completedDateTime??null,event_payload_base64:Buffer.from(JSON.stringify(normalized)).toString('base64')}}];"},
